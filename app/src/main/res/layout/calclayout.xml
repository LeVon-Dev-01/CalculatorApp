<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="10dp"
    android:background="#121212">

    <!-- Calculator display -->

    <TextView
        android:id="@+id/calculatorDisplay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="LeVon 42413849"
        android:textColor="#FFFFFF"
        android:textSize="42sp"
        android:gravity="center"
        android:padding="16dp"
        android:singleLine="false"
        android:ellipsize="none"
        android:maxLines="2"
        android:background="#1E1E1E" />

    <!-- Calculator buttons -->

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5"
        android:layout_gravity="center"
        android:useDefaultMargins="true">

        <!-- Row 1 -->

        <Button
            android:id="@+id/button7"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="7"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4B2E83" />

        <Button
            android:id="@+id/button8"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="8"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4B2E83" />

        <Button
            android:id="@+id/button9"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="9"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4B2E83" />

        <Button
            android:id="@+id/buttonDivide"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="/"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9800" />

        <!-- Row 2 -->

        <Button
            android:id="@+id/button4"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="4"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4B2E83" />

        <Button
            android:id="@+id/button5"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="5"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4B2E83" />

        <Button
            android:id="@+id/button6"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="6"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4B2E83" />

        <Button
            android:id="@+id/buttonMultiply"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="*"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9800" />

        <!-- Row 3 -->

        <Button
            android:id="@+id/button1"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="1"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4B2E83" />

        <Button
            android:id="@+id/button2"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="2"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4B2E83" />

        <Button
            android:id="@+id/button3"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="3"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4B2E83" />

        <Button
            android:id="@+id/buttonSubtract"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="-"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9800" />

        <!-- Row 4 -->

        <Button
            android:id="@+id/button0"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="0"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4B2E83" />

        <Button
            android:id="@+id/buttonDecimal"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="."
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4B2E83" />

        <Button
            android:id="@+id/buttonOpenParen"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="("
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9800" />

        <Button
            android:id="@+id/buttonCloseParen"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text=")"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9800" />

        <!-- Row 5 -->

        <Button
            android:id="@+id/buttonAC"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="AC"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF3377" />

        <Button
            android:id="@+id/buttonClear"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="C"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#337DFF" />

        <Button
            android:id="@+id/buttonAdd"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="+"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9800" />

        <Button
            android:id="@+id/buttonEquals"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="="
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9800" />

    </GridLayout>

    <!-- Base converter -->

    <Button
        android:id="@+id/buttonBases"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginTop="8dp"
        android:text="BASE CONVERTER"
        android:textSize="22sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF9800" />

</LinearLayout>