<?xml version="1.0" encoding="utf-8"?>

<!--
    Main calculator layout.

    Contains:
    1. Calculator display
    2. Number buttons
    3. Operator buttons
    4. Decimal button
    5. Equals button
    6. Base converter button
-->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"

    android:padding="6dp"

    android:background="#121212">


    <!--
        ============================================================
        CALCULATOR DISPLAY
        ============================================================

        Displays the current number or calculation.
        singleLine prevents the display from wrapping.
    -->

    <TextView
        android:id="@+id/calculatorDisplay"

        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="2"

        android:gravity="center_vertical|end"

        android:padding="20dp"

        android:text="0"

        android:textColor="#FFFFFF"
        android:textSize="48sp"

        android:singleLine="true"
        android:ellipsize="start"

        android:background="#1E1E1E" />


    <!--
        ============================================================
        CALCULATOR BUTTON GRID
        ============================================================
    -->

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="6"

        android:columnCount="4"
        android:rowCount="6"

        android:paddingTop="6dp">


        <!-- ROW 1: 7 | 8 | 9 | / -->

        <!-- Number 7 button -->
        <Button
            android:id="@+id/button7"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="2dp"
            android:text="7"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/square_button"
            app:backgroundTint="#4B2E83" />

        <!-- Number 8 button -->
        <Button
            android:id="@+id/button8"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="2dp"
            android:text="8"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/square_button"
            app:backgroundTint="#4B2E83" />

        <!-- Number 9 button -->
        <Button
            android:id="@+id/button9"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="2dp"
            android:text="9"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/square_button"
            app:backgroundTint="#4B2E83" />

        <!-- Division operator button -->
        <Button
            android:id="@+id/buttonDivide"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="2dp"
            android:text="/"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/operator_button"
            app:backgroundTint="#FF9800" />


        <!-- ROW 2: 4 | 5 | 6 | * -->

        <!-- Number 4 button -->
        <Button
            android:id="@+id/button4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="2dp"
            android:text="4"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/square_button"
            app:backgroundTint="#4B2E83" />

        <!-- Number 5 button -->
        <Button
            android:id="@+id/button5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="2dp"
            android:text="5"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/square_button"
            app:backgroundTint="#4B2E83" />

        <!-- Number 6 button -->
        <Button
            android:id="@+id/button6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="2dp"
            android:text="6"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/square_button"
            app:backgroundTint="#4B2E83" />

        <!-- Multiplication operator button -->
        <Button
            android:id="@+id/buttonMultiply"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="2dp"
            android:text="*"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/operator_button"
            app:backgroundTint="#FF9800" />


        <!-- ROW 3: 1 | 2 | 3 | - -->

        <!-- Number 1 button -->
        <Button
            android:id="@+id/button1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="2dp"
            android:text="1"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/square_button"
            app:backgroundTint="#4B2E83" />

        <!-- Number 2 button -->
        <Button
            android:id="@+id/button2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="2dp"
            android:text="2"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/square_button"
            app:backgroundTint="#4B2E83" />

        <!-- Number 3 button -->
        <Button
            android:id="@+id/button3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="2dp"
            android:text="3"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/square_button"
            app:backgroundTint="#4B2E83" />

        <!-- Subtraction operator button -->
        <Button
            android:id="@+id/buttonSubtract"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="2dp"
            android:text="-"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/operator_button"
            app:backgroundTint="#FF9800" />


        <!-- ROW 4: 0 | . | C | + -->

        <!-- Number 0 button -->
        <Button
            android:id="@+id/button0"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="2dp"
            android:text="0"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/square_button"
            app:backgroundTint="#4B2E83" />

        <!-- Decimal point button -->
        <Button
            android:id="@+id/buttonDecimal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="2dp"
            android:text="."
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/square_button"
            app:backgroundTint="#4B2E83" />

        <!-- Clear calculator button -->
        <Button
            android:id="@+id/buttonClear"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="2dp"
            android:text="C"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/operator_button"
            app:backgroundTint="#FF9800" />

        <!-- Addition operator button -->
        <Button
            android:id="@+id/buttonAdd"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="2dp"
            android:text="+"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/operator_button"
            app:backgroundTint="#FF9800" />


        <!-- ROW 5: Equals -->

        <!-- Equals button spans all four columns -->
        <Button
            android:id="@+id/buttonEquals"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnSpan="4"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="2dp"
            android:text="="
            android:textSize="32sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/operator_button"
            app:backgroundTint="#FF9800" />


        <!-- ROW 6: Base Converter -->

        <!-- Opens the Base Converter -->
        <Button
            android:id="@+id/buttonBases"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnSpan="4"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="2dp"
            android:text="Bases"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/operator_button"
            app:backgroundTint="#FF9800" />

    </GridLayout>

</LinearLayout>